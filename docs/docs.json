{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Views on technical writing",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart", "customization"]
          },
          {
            "group": "Content",
            "pages": ["components", "guides/example"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/DanRoscigno/mintlifytesting",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Linkedin",
          "href": "https://linkedin.com/in/danroscigno",
          "icon": "book-open-cover"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Contact",
        "href": "mailto:dan@roscigno.com"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
